<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  DOCUMENTATION ONLY. DO NOT FILL THIS IN AND DO NOT COMMIT IT.
  ============================================================================

  This file is a reference for the settings that
  TechStackLearningHub.Web/Helpers/SmtpResetNotifier.cs reads. The running
  application NEVER opens this file: there is no <appSettings file="..."> and
  no configSource in Web.config, and that is on purpose. A referenced external
  config file makes a fresh clone fail to start the entire site with a
  configuration error, which is a far worse failure than "SMTP is not
  configured" on one page.

  HOW REAL VALUES ARE SUPPLIED
  Each key below is resolved in this order, first hit wins:

    1. an ENVIRONMENT VARIABLE with exactly the key's name
    2. the <appSettings> entry of the same name in Web.config
    3. otherwise the setting counts as not configured, and sending a reset
       link throws InvalidOperationException naming the missing keys

  The environment variable wins because Web.config is tracked by git: a real
  username or password typed into Web.config is a committed secret the moment
  anybody pushes. Web.config therefore contains EMPTY placeholders for the
  host, user, password and from address, and the real values live in the
  machine's or the deployment environment's environment. The placeholders also
  keep a fresh clone working - the site starts and the reset page reports that
  SMTP is not configured - which is the whole point of not using an external
  config file.

  So: to use real SMTP, set the environment variables on the box running the
  site. Do not edit this file, and do not edit the values in Web.config.
  (Smtp.config, Smtp.config.local and *.local.config are in .gitignore as a
  backstop, in case somebody copies this file aside to work in.)
-->
<smtpConfiguration>
  <!--
    Every key is also the name of its environment variable. "Required" means
    the notifier throws rather than guessing, because a guessed value fails
    later and further from its cause: a wrong host looks like an outage, a
    wrong port looks like a firewall, and a missing from-address looks like the
    relay rejecting mail.
  -->
  <settings>
    <setting key="SMTP_HOST" envVar="SMTP_HOST" required="true">
      <description>
        Hostname or IP address of the SMTP relay. No scheme, no path, no port
        suffix: the port is a separate setting. Example: smtp.gmail.com or
        127.0.0.1.
      </description>
    </setting>

    <setting key="SMTP_PORT" envVar="SMTP_PORT" required="true">
      <description>
        Relay port, parsed as a whole number with invariant culture and
        validated to the range 1 to 65535. 587 is STARTTLS submission and is
        the right answer for a real mailbox provider. 25 is plain
        submission, and 465 is implicit TLS - which System.Net.Mail's
        SmtpClient cannot negotiate, so 465 needs a different client rather
        than a different setting here. A local test sink commonly listens on
        1025.
      </description>
    </setting>

    <setting key="SMTP_ENABLE_SSL" envVar="SMTP_ENABLE_SSL" required="true">
      <description>
        true or false, and nothing else - the value is parsed as a bool, so
        "yes" and "1" are rejected rather than quietly read as false. True for
        587 submission, false for an unencrypted local sink. This is required
        rather than defaulted so that nobody ends up sending mail credentials
        in the clear because a setting was quietly absent.
      </description>
    </setting>

    <setting key="SMTP_FROM" envVar="SMTP_FROM" required="true">
      <description>
        The From address on the reset message. Must be an address the relay is
        willing to send as, or the relay will reject the message. It is
        configuration, never derived from the current request. A display name
        may be included in configuration ("TechStack Learning Hub
        (no-reply) &lt;noreply@example.com&gt;"); it is parsed as a
        MailAddress, never concatenated into a header by hand.
      </description>
    </setting>

    <setting key="SMTP_USER" envVar="SMTP_USER" required="false">
      <description>
        Username for relay authentication. Leave blank for a relay that needs
        no authentication. It must be set together with SMTP_PASSWORD: half a
        pair is rejected rather than being read as "no authentication",
        because a relay that accepts mail from anyone is not what a half
        configured pair usually means.
      </description>
    </setting>

    <setting key="SMTP_PASSWORD" envVar="SMTP_PASSWORD" required="false">
      <description>
        Password or app password for relay authentication. This is the value
        that must never be written into a tracked file. Prefer an app
        password or an API key over the account's real password, and revoke it
        without ceremony if it ever lands somewhere public.
      </description>
    </setting>

    <setting key="PASSWORD_RESET_BASE_URL" envVar="PASSWORD_RESET_BASE_URL" required="true">
      <description>
        Absolute base address that reset links are built on, combined with the
        reset page path. MUST end with a trailing slash. It is a setting
        rather than something read from the incoming request on purpose: a Host
        header an attacker controls would otherwise end up inside an email the
        victim has every reason to trust. The default in Web.config,
        http://localhost:8099/, is the site's real IIS Express URL; anything
        deployed must be set to the address that actually serves this site.
      </description>
    </setting>
  </settings>

  <!--
    WORKED EXAMPLES. Both are environment variables, not file edits. Neither
    contains a real credential.
  -->
  <workedExamples>

    <example name="Gmail or Outlook.com with an app password">
      <notes>
        Mailbox providers refuse the account's normal password over SMTP and
        require an app password instead, which is a separate generated
        credential that can be revoked without changing the account password.
        In PowerShell, for the current session only:
      </notes>
      <commands>
        <command>$env:SMTP_HOST = "smtp.gmail.com"</command>
        <command>$env:SMTP_PORT = "587"</command>
        <command>$env:SMTP_USER = "you@gmail.com"</command>
        <command>$env:SMTP_PASSWORD = "PASTE THE 16-CHARACTER APP PASSWORD HERE"</command>
        <command>$env:SMTP_ENABLE_SSL = "true"</command>
        <command>$env:SMTP_FROM = "you@gmail.com"</command>
        <command>$env:PASSWORD_RESET_BASE_URL = "http://localhost:8099/"</command>
      </commands>
      <notes>
        To make these survive a reboot, set them at machine or user scope
        instead of per session - for example System Properties, Environment
        Variables, or setx in a command prompt, which does not affect the
        current session either. IIS Express and IIS read the environment of
        the process they start, so a variable set after the site is already
        running is not visible to it; restart the site after setting them.
      </notes>
    </example>

    <example name="Local test SMTP sink, no authentication">
      <notes>
        The test sink being built listens on 127.0.0.1:1025 and accepts mail
        from anywhere with no credentials and no encryption, so it needs no
        user, no password and no TLS. Leave SMTP_USER and SMTP_PASSWORD unset
        rather than setting them to empty-looking placeholders.
      </notes>
      <commands>
        <command>$env:SMTP_HOST = "127.0.0.1"</command>
        <command>$env:SMTP_PORT = "1025"</command>
        <command>$env:SMTP_USER = ""</command>
        <command>$env:SMTP_PASSWORD = ""</command>
        <command>$env:SMTP_ENABLE_SSL = "false"</command>
        <command>$env:SMTP_FROM = "noreply@localhost"</command>
        <command>$env:PASSWORD_RESET_BASE_URL = "http://localhost:8099/"</command>
      </commands>
      <notes>
        The send has a 15 second timeout rather than the SmtpClient default of
        100, so a sink that is not running produces a logged failure quickly
        instead of holding the request open. The visitor still sees the same
        neutral confirmation either way, because the notifier throws, AuthBLL
        logs it, and the page reveals nothing about whether the address
        existed.
      </notes>
    </example>

  </workedExamples>

  <!--
    A NOTE ON WHAT IS NEVER LOGGED: the reset link is a live credential for as
    long as its token is redeemable. It appears in the message body and
    nowhere else - not in an exception message, not in the error log, not in
    this file. A local sink is the one exception in spirit rather than in
    fact: a sink captures mail by design, so treat its output as a secret too.
  -->
</smtpConfiguration>
